{
  "schema_version": 1,
  "project": "my-service",
  "adapter": "scripts/adapters/custom.sh",
  "remote": "origin",
  "production_base": "develop",
  "test_base": "sandbox",
  "repository": "my-org/my-service",
  "promotion": {
    "main_branch": "main",
    "push_remote": "origin",
    "candidate_workflow": ".github/workflows/candidate.yml",
    "required_job": "Candidate OK",
    "signature_verification": "github",
    "publisher_ref": "main"
  },
  "storage": {
    "uri": "s3://my-release-bucket/my-service",
    "region": "us-east-1"
  },
  "publishers": {
    "github-release": {
      "required": true,
      "assets": ["*"]
    },
    "oci": {
      "required": false,
      "artifact": "{project}-{version}-oci.tar",
      "repository": "ghcr.io/my-org/{project}",
      "tags": ["{version}"],
      "latest_tag": "latest"
    },
    "docs": {
      "required": false,
      "artifact": "{project}-{version}-docs.tar.gz",
      "uri": "s3://my-docs-bucket/{project}",
      "latest": true
    }
  }
}
